# ColonVision AI — Frontend Environment Variables (Vite / Vercel)
#
# In local development:
# Leave empty or set to http://localhost:8000 (Vite proxies /api to backend by default)
# VITE_API_BASE_URL=http://localhost:8000
#
# In Vercel Production Deployment:
# Point to the deployed Render backend URL (no trailing slash):
VITE_API_BASE_URL=https://colonvision-ai.onrender.com
