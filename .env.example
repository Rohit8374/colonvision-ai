# ColonVision AI — Backend Environment Variables (FastAPI / Render)
#
# Allowed frontend origins for CORS (comma-separated, without trailing slash):
# Example: https://colonvision-ai.vercel.app,http://localhost:3000
FRONTEND_ORIGINS=https://colonvision-ai.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Server configuration (Render injects PORT automatically)
PORT=8000
HOST=0.0.0.0

# PyTorch cache directory
TORCH_HOME=.torch_cache
